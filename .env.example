# Copy this file to `.env` (gitignored) and fill in real values.
# Docker Compose auto-loads ./.env at the project root and interpolates
# ${VAR} references in compose.yaml.

# Paperless API token consumed by paperless-gpt.
# Generate at: http://localhost:8000  ->  Profile  ->  API Tokens  ->  Generate
PAPERLESS_API_TOKEN=
