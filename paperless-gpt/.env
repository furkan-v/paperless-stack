TZ=Europe/Berlin

PAPERLESS_BASE_URL=http://paperless:8000
# PAPERLESS_PUBLIC_URL=http://paperless.mydomain.com  # Optional
# PAPERLESS_API_TOKEN is set in project-root ./.env (gitignored). See .env.example.

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_HOST=http://ollama:11434
OLLAMA_CONTEXT_LENGTH=8192   # Sets Ollama NumCtx (context window)
TOKEN_LIMIT=1000             # Recommended for smaller models

LLM_LANGUAGE=English         # Optional, default: English

OCR_PROVIDER=llm                          # Default OCR provider
VISION_LLM_PROVIDER=ollama                # openai, ollama, mistral, or anthropic
VISION_LLM_MODEL=qwen3-vl:2b-instruct     # minicpm-v (ollama) / gpt-4o (openai) / claude-sonnet-4-5 (anthropic)

IMAGE_MAX_RENDER_DPI=120
IMAGE_MAX_PIXEL_DIMENSION=1600
IMAGE_MAX_TOTAL_PIXELS=3200000

AUTO_OCR_TAG=paperless-gpt-ocr-auto
AUTO_TAG=paperless-gpt-auto
MANUAL_TAG=paperless-gpt-manual
PDF_OCR_TAGGING=true
PDF_OCR_COMPLETE_TAG=paperless-gpt-ocr-complete
PDF_UPLOAD=false

LOG_LEVEL=DEBUG

# For a full list of configuration options, see the documentation at:
# https://github.com/icereed/paperless-gpt?tab=readme-ov-file#docker-compose
