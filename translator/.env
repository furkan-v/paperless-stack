TZ=Europe/Berlin

PAPERLESS_BASE_URL=http://paperless:8000

OLLAMA_HOST=http://ollama:11434
TRANSLATE_MODEL=translategemma:4b
POLL_INTERVAL=60

# Comma-separated ISO 639-1 codes whose detected language should NOT be
# translated. Docs are still marked Is Translated=true so they exit the queue.
# `en` is always force-included by the service (never translate to ourselves).
SKIP_LANGUAGES=en,tr

# Skip documents whose OCR'd content is shorter than this (langdetect needs a
# few sentences to be reliable, and there's nothing useful to translate either way).
MIN_CONTENT_LENGTH=30

# Cap the prompt size to keep latency sane. Longer docs get truncated with a note appended.
MAX_CONTENT_LENGTH=30000
